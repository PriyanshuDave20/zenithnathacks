# Shared hosted Postgres (Neon/Supabase/Prisma Postgres) so every laptop uses the same DB.
# Get the real URL from the team, never commit it.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Mock works offline without a model or key. NVIDIA processes English summaries/replies.
LLM_PROVIDER="mock"
# Mock ignores this value; NVIDIA uses this model by default.
LLM_MODEL="nvidia/nemotron-3.5-lightning-30b-a3b"
# Server only. Never prefix keys with NEXT_PUBLIC_ or commit your actual .env.
NVIDIA_API_KEY=""
# Optional HTTPS /v1 base URL; defaults to NVIDIA's hosted API.
# NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"

# Text translation is separate from the English LLM. Defaults to offline synthetic fixtures.
# Set "azure" to enable Azure Translator for free text/transcripts and clinician replies.
TRANSLATION_PROVIDER="mock"
AZURE_TRANSLATOR_KEY=""
# Use the resource's region; "global" for a global Translator resource.
AZURE_TRANSLATOR_REGION="global"

# Read-aloud defaults to browser voices. Azure uses prebuilt neural voices, server only.
SPEECH_PROVIDER="browser"
AZURE_SPEECH_KEY=""
# Example only: use the actual region from your Speech resource.
AZURE_SPEECH_REGION="canadacentral"
