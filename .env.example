# Shared hosted Postgres (Neon/Supabase/Prisma Postgres) so every laptop uses the same DB.
# Get the real URL from the team, never commit it.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Mock works offline without a model or key. Real adapters will be added later.
LLM_PROVIDER="mock"
# Reserved for a future adapter; mock ignores this value.
LLM_MODEL=""
# Future provider API key (use the variable name required by that adapter):
# MODEL_API_KEY=""
